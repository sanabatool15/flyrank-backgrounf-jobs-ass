# Copy this file to .env and fill in real values.
# For local dev with the Inngest Dev Server, these can stay blank.

# Inngest signing/event keys (only needed for Inngest Cloud, not local Dev Server)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Set to "development" to run against the local Inngest Dev Server
INNGEST_DEV=1

# Port the FastAPI app listens on
PORT=8000
